@article{hoijtink_open_nodate,
	title = {The {Open} {Empirical} {Cycle} for {Hypothesis} {Evaluation} in {Psychology}},
	abstract = {In the last decade it has become clear that replicability of empirical psychological research should be better. Open science practices aim to enhance the transparency and accessibility of research thereby both enabling others to reproduce the results presented in a paper and increasing the replicability of these results. Examples of these practices include preregistration, publication of data and analyses, open access publications, and replication research. Although open science practices are gaining traction, they have rarely been placed in a broader epistemological context. To address this shortcoming, this paper introduces the open empirical cycle. It draws upon De Groot’s empirical cycle, a model of cumulative knowledge generation via scientific research and adds open science practices. Adhering to the open empirical cycle, if only partly, will structure the scientific workflow and create awareness of the adverse consequences of deviations. Following the open empirical cycle increases the transparency, quality, trustworthiness, and replicability of research.},
	language = {en},
	author = {Hoijtink, Herbert and de Bruin, Jonathan and Duken, Sascha and Flores, Jacques and Lissa, Caspar J Van},
