@article{ravn_exploring_2021,
	title = {Exploring the {Gray} {Area}: {Similarities} and {Differences} in {Questionable} {Research} {Practices} ({QRPs}) {Across} {Main} {Areas} of {Research}},
	volume = {27},
	issn = {1471-5546 (Electronic) 1353-3452 (Linking)},
	doi = {10.1007/s11948-021-00310-z},
	abstract = {This paper explores the gray area of questionable research practices (QRPs) between responsible conduct of research and severe research misconduct in the form of fabrication, falsification, and plagiarism (Steneck in SEE 12(1): 53-57, 2006). Up until now, we have had very little knowledge of disciplinary similarities and differences in QRPs. The paper is the first systematic account of variances and similarities. It reports on the findings of a comprehensive study comprising 22 focus groups on practices and perceptions of QRPs across main areas of research. The paper supports the relevance of the idea of epistemic cultures (Knorr Cetina in: Epistemic cultures: how the sciences make knowledge, Harvard University Press, Cambridge, 1999), also when it comes to QRPs. It shows which QRPs researchers from different areas of research (humanities, social sciences, medical sciences, natural sciences, and technical sciences) report as the most severe and prevalent within their fields. Furthermore, it shows where in the research process these self-reported QRPs can be found. This is done by using a five-phase analytical model of the research process (idea generation, research design, data collection, data analysis, scientific publication and reporting). The paper shows that QRPs are closely connected to the distinct research practices within the different areas of research. Many QRPs can therefore only be found within one area of research, and QRPs that cut across main areas often cover relatively different practices. In a few cases, QRPs in one area are considered good research practice in another.},
	number = {4},
	journal = {Sci Eng Ethics},
	author = {Ravn, T. and Sorensen, M. P.},
	month = jun,
	year = {2021},
	keywords = {Humans, Self Report, *Biomedical Research, Research integrity, Responsible conduct of research, *Scientific Misconduct, Disciplinary differences, Epistemic culture, Publications, Qrp, Research Misconduct, Research Personnel, Universities},
	pages = {40},
	annote = {Ravn, TineSorensen, Mads PengResearch Support, Non-U.S. Gov'tEngland2021/06/18Sci Eng Ethics. 2021 Jun 16;27(4):40. doi: 10.1007/s11948-021-00310-z.},
	annote = {The following values have no corresponding Zotero field:auth-address: Department of Political Science, The Danish Centre for Studies in Research and Research Policy, Aarhus University, Bartholins Alle 7, 8000, Aarhus C, Denmark. tr@ps.au.dk. Department of Political Science, The Danish Centre for Studies in Research and Research Policy, Aarhus University, Bartholins Alle 7, 8000, Aarhus C, Denmark.edition: 20210616accession-num: 34136962},
