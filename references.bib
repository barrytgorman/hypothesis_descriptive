	annote = {Vandenbroucke, Jan PPearce, Neileng668954/ERC\_/European Research Council/InternationalNew Zealand2018/03/23Clin Epidemiol. 2018 Mar 6;10:253-264. doi: 10.2147/CLEP.S142940. eCollection 2018.},
