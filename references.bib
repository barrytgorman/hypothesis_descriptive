	pages = {1753--1760},
	file = {PDF:/Users/barrygorman/Zotero/storage/ZGFAMLNF/Malterud et al. - 2016 - Sample Size in Qualitative Interview Studies Guided by Information Power.pdf:application/pdf},
}

