	annote = {The following values have no corresponding Zotero field:auth-address: School of Sport, Exercise and Rehabilitation, Faculty of Health, University of Technology Sydney, Australia. Electronic address: Franco.Impellizzeri@uts.edu.au. School of Sport, Exercise and Rehabilitation, Faculty of Health, University of Technology Sydney, Australia. Spinal Research Laboratory, Department of Physical Therapy, Stanley Steyer School of Health Professions, Sackler Faculty of Medicine, Tel Aviv University, Israel. Arsenal Performance and Research Team, Arsenal Football Club, United Kingdom. Newcastle Falcons Rugby Club, United Kingdom; Department of Sport and Exercise Sciences, Durham University, United Kingdom.accession-num: 35523475},
	file = {1-s2.0-S1440244021004692-main:/Users/barrygorman/Zotero/storage/69AUDL6F/1-s2.0-S1440244021004692-main.pdf:application/pdf},
