	keywords = {*Research Design, Humans, Probability, medical education \& training, protocols \& guidelines, qualitative research, Statistical, Data Interpretation},
	pages = {e052953},
	annote = {Clark, Timothy PeterKahan, Brennan CPhillips, AlanWhite, IanCarpenter, James RengMC\_UU\_00004/07/MRC\_/Medical Research Council/United KingdomMC\_UU\_00004/09/MRC\_/Medical Research Council/United KingdomResearch Support, Non-U.S. Gov'tReviewEngland2022/01/05BMJ Open. 2022 Jan 3;12(1):e052953. doi: 10.1136/bmjopen-2021-052953.},
