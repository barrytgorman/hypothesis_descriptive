	keywords = {publication bias, Computer Simulation, p-hacking, *Statistics as Topic, *Publication Bias, p-curve},
	pages = {666--81},
	annote = {Simonsohn, UriNelson, Leif DSimmons, Joseph PengValidation Study2015/07/18Perspect Psychol Sci. 2014 Nov;9(6):666-81. doi: 10.1177/1745691614553988.},
	annote = {The following values have no corresponding Zotero field:auth-address: University of Pennsylvania uws@wharton.upenn.edu. University of California, Berkeley. University of Pennsylvania.accession-num: 26186117},
	file = {1745691614553988:/Users/barrygorman/Zotero/storage/DPSMWZNQ/1745691614553988.pdf:application/pdf},
