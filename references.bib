	file = {PDF:/Users/barrygorman/Zotero/storage/54YGZBMW/Zoughaib et al. - 2026 - Opposing Effects of Dietary Nitrate on Muscle Contractile Function in Fast and Slow Human Muscles.pdf:application/pdf},
