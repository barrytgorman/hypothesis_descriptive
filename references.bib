	pages = {1225--36},
	annote = {Stallinga, Hillegonda ADijkstra, Pieter UBos, IsaacHeerkens, Yvonne FRoodbol, Petrie FengEngland2014/06/12Clin Rehabil. 2014 Dec;28(12):1225-36. doi: 10.1177/0269215514537092. Epub 2014 Jun 10.},
