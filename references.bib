	pages = {726--734},
	file = {PDF:/Users/barrygorman/Zotero/storage/JCVMMW2U/Kalkhoven et al. - 2020 - A conceptual model and detailed framework for stress-related, strain-related, and overuse athletic i.pdf:application/pdf},
}

