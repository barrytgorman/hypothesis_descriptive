	keywords = {Humans, *Psychological Theory, *Psychology/trends},
	pages = {220--231},
	annote = {Hutmacher, FabianFranz, David Jeng2024/01/25Am Psychol. 2025 Feb-Mar;80(2):220-231. doi: 10.1037/amp0001300. Epub 2024 Jan 25.},
	annote = {The following values have no corresponding Zotero field:auth-address: Human-Computer-Media Institute, Julius-Maximilians-Universitat Wurzburg.edition: 20240125accession-num: 38271030},
	file = {HutmacherFranz2023Exploringthevagueness:/Users/barrygorman/Zotero/storage/W5F95Z59/HutmacherFranz2023Exploringthevagueness.pdf:application/pdf},
