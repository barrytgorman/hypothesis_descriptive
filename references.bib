	file = {PDF:/Users/barrygorman/Zotero/storage/94MQJWUB/Fleitas‐Paniagua et al. - 2026 - Recommended but Not High Carbohydrate Dose Improves Performance After Heavy‐ but Not Moderate‐Intens.pdf:application/pdf},
